# Allow inbound traffic from VPN peers
-t nat -A POSTROUTING -s 10.10.1.0/24  -d 192.168.40.0/24 -j MASQUERADE
-t nat -A POSTROUTING -s 10.10.2.0/24  -d 192.168.40.0/24 -j MASQUERADE
-t nat -A POSTROUTING -s 10.20.30.0/24 -d 192.168.40.0/24 -j MASQUERADE
-t nat -A POSTROUTING -s 192.168.32.0/24 -d 192.168.40.0/24 -j MASQUERADE
-t nat -A POSTROUTING -s 10.100.253.0/24 -d 192.168.40.0/24 -j MASQUERADE
-t nat -A POSTROUTING -s 10.100.254.0/24 -d 192.168.40.0/24 -j MASQUERADE